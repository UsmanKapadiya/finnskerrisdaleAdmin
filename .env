# Laravel API base URL (no trailing slash)
VITE_API_URL=https://backend.finnskerrisdaleladies.intellimanagement.com/api
# Public website URL (for "View site" links and previews)
VITE_SITE_URL=http://localhost:5174
# "/" when served from admin.yourdomain.com, "/admin/" when served under a path
VITE_BASE_PATH=/
# Longest side (px) photos are scaled to in the browser before upload — keep equal to IMAGE_MAX_WIDTH on the API
VITE_IMAGE_MAX_SIDE=2000
